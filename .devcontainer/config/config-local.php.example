/**
 * Modelo de ajuste local da maquina.
 *
 * COPIE para config-local.php na raiz do site, ao lado do config.php:
 *
 *   cp .devcontainer/config/config-local.php.example config-local.php
 *
 * O config.php e GERADO a cada deploy e nao aceita edicao permanente. Este
 * arquivo, sim: ele fica no EXCLUDE do rsync e o deploy nunca o toca.
 *
 * Ele e incluido DEPOIS de todo o config.php e ANTES do lib/setup.php, entao
 * pode sobrescrever qualquer $CFG e ainda esta a tempo de valer.
 *
 * Use com parcimonia. Ajuste que vale para o projeto inteiro pertence ao
 * template versionado, onde fica visivel em code review e chega a todas as
 * maquinas. Este arquivo e para o que e verdadeiro em UMA maquina so.
 *
 * @package    core
 * @copyright  2026 LeoDG <callme@leodg.dev>
 * @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
 */

defined('MOODLE_INTERNAL') || die();

