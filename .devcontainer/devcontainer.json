// See https://containers.dev/implementors/json_reference/ for configuration reference
//
// ============================================================================
// POR QUE ESTE ARQUIVO NAO TEM "features" NEM "build-dev.yml"
// ============================================================================
// Este projeto usa varias worktrees do mesmo repo bare, e cada uma abre uma
// janela do VS Code. Duas coisas faziam o "Reopen in Container" reconstruir a
// imagem toda vez que se abria uma worktree nova:
//
//   1. "features". Cada feature declarada obriga a CLI do Dev Containers a
//      construir uma imagem DERIVADA para injeta-la, por pasta. As tres que
//      existiam aqui foram resolvidas na origem: git ja vem instalado no stage
//      development do Dockerfile, common-utils nao agregava com remoteUser
//      www-data, e shell-history virou ENV HISTFILE + volume nomeado.
//
//   2. "build-dev.yml" na lista abaixo. Aquele arquivo tem uma secao "build:"
//      com context ../../ - o caminho muda a cada worktree, entao o cache nao
//      aproveita e a imagem e reconstruida. Aqui usamos a imagem ja publicada
//      (leodg/courses-free:development). Para reconstruir de proposito, use
//      "moodev build", que carrega o build-dev.yml explicitamente.
//
// Resultado: abrir uma worktree nova conecta no container em segundos, sem
// build. Ver .devcontainer/bin/moodev.
// ============================================================================
{
    // O basename identifica a worktree na barra de titulo. Com varias janelas
    // abertas ao mesmo tempo, sem isso nao da para saber qual e qual.
    "name": "courses-free — ${localWorkspaceFolderBasename}",

    // Mesma lista que o "moodev" usa para subir o stack. Precisa bater exatamente:
    // se divergir, a extensao considera a configuracao diferente e RECRIA os
    // containers que o cf acabou de subir.
    //
    // local-tls.yml e local-dev.yml sao SO LOCAIS. O COMPOSE_FILE da VPS e
    // apenas base.yml:db.yml:dev.yml (ver .github/workflows/deploy.yml).
    // local-tls.yml publica a 443 do container; sem ele, abrir pelo VS Code
    // perderia o HTTPS que o MOODLE_URL exige.
    "dockerComposeFile": [
        "./compose/base.yml",
        "./compose/db.yml",
        "./compose/dev.yml",
        "./compose/local-tls.yml",
        "./compose/local-dev.yml"
    ],
    "service": "moodle",
    "runServices": [
        "moodle",
        "db"
    ],

    // Raiz do repo, nao public/: o config.php mora aqui, fora do webroot.
    "workspaceFolder": "/var/www/html",
    "remoteUser": "www-data",

    // Fechar a janela do VS Code NAO derruba o stack. Sem isto, fechar a
    // worktree A mataria o ambiente que estava rodando, e o padrao com compose
    // e parar os servicos.
    "shutdownAction": "none",

    // O ENTRYPOINT da imagem (moodle-entrypoint) precisa rodar: e ele que
    // configura Apache, TLS e permissoes. Sobrescrever deixaria o Apache parado.
    "overrideCommand": false,

    // Mounts para compartilhar configuracao e chaves entre host e container.
    "mounts": [
        {
            "source": "${localEnv:HOME}/.gitconfig",
            "target": "/home/www-data/.gitconfig",
            "type": "bind"
        },
        {
            "source": "${localEnv:HOME}/.ssh",
            "target": "/home/www-data/.ssh",
            "type": "bind"
        },
        // Historico de shell por worktree, em volume nomeado. Substitui o bind
        // em ../../moodle-academy-bashhistory, que era do projeto anterior.
        // Volume e nao bind porque o docker inicializa um volume nomeado com o
        // conteudo e o dono que a imagem ja tem em /commandhistory; um bind numa
        // pasta nova do host entraria como root e o www-data nao escreveria.
        {
            "source": "courses-free-history-${localWorkspaceFolderBasename}",
            "target": "/commandhistory",
            "type": "volume"
        }
        // Removidos: o bind de ../../moodledata-academy apontava para um caminho
        // que NAO EXISTE nesta maquina, e o moodledata real ja vem pelo dev.yml
        // via MOODLE_HOST_DATA.
    ],

    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            // Add the IDs of extensions you want to install.
            "extensions": [
                "ms-vscode-remote.remote-containers",
                "LMSCloud.mdlcode",
                "shardulm94.trailing-spaces",
                "shuworks.vscode-table-formatter",
                "stevejpurves.cucumber",
                "shevaua.phpcs",
                "DEVSENSE.profiler-php-vscode",
                "MehediDracula.php-namespace-resolver",
                "xdebug.php-pack",
                "xdebug.php-debug",
                "DEVSENSE.phptools-vscode",
                "imgildev.vscode-mustache-snippets",
                "imgildev.vscode-moodle-snippets",
                "eamodio.gitlens",
                "dbaeumer.vscode-eslint",
                "cweijan.dbclient-jdbc",
                "cweijan.vscode-database-client2",
                "ms-azuretools.vscode-containers",
                "DEVSENSE.composer-php-vscode",
                "neilbrayfield.php-docblocker",
                "ms-vscode-remote.vscode-remote-extensionpack"
            ],
            // Add custom VS Code settings.
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "icon": "terminal-bash"
                    }
                },
                "php.suggest.basic": false,
                "php.validate.enable": false
            }
        }
    },
    "containerEnv": {
        // core.filemode=false: o bind mount do repo nao preserva o bit de
        // execucao igual ao host, e sem isto o git marca metade da arvore como
        // modificada.
        "GIT_CONFIG_PARAMETERS": "'core.filemode=false'",
        "COMPOSER_ALLOW_PLUGINS": "dealerdirect/phpcodesniffer-composer-installer:true"
    }
}
