
# =============================================================================
# DEFAULTS — Valores compartilhados entre dev e prod (não-sensíveis)
# Sobrescrito por development.env ou production.env
# =============================================================================

# Moodle 5.2: PHP >= 8.3.0 e MariaDB >= 10.11 (admin/environment.xml).
# Usamos o topo do suportado: PHP 8.4 (maior tag da moodlehq) e MariaDB 11.4.
MOODLE_DOCKER_PHP_VERSION=8.4
MOODLE_DOCKER_BROWSER=firefox
MOODLE_DOCKER_DB_VERSION=mariadb:11.4

# Database Configuration
MOODLE_DBTYPE=mysqli
MOODLE_DBLIB=native
MOODLE_DBHOST=db
MOODLE_DBNAME=moodle
MOODLE_DBPFX=mdl_
MOODLE_DBCOLL=utf8mb4_bin

# Moodle Paths
# MOODLE_DOCKER_WWWROOT e a raiz do repo (onde fica config.php).
# O Apache serve APACHE_DOCUMENT_ROOT, que aponta para public/ dentro dela.
MOODLE_DATA=/var/www/moodledata
MOODLE_DOCKER_WWWROOT=/var/www/html
APACHE_DOCUMENT_ROOT=/var/www/html/public

# Admin
MOODLE_ADMIN=admin

# Apache
APACHE_RUN_USER=www-data
APACHE_RUN_GROUP=www-data

# Timezone
TZ=America/Sao_Paulo

# PHP Settings
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M