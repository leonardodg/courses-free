{{!
    @template local_partners/sectionbar

    Barra fina de secoes da landing, pegajosa ao rolar.

    NAO substitui a navegacao do tema. O mockup trazia navbar propria com
    hamburguer; portar aquilo seria dois menus fazendo um trabalho so, e o
    cabecalho do Moodle carrega login, idioma e acessibilidade. Aqui ficam
    apenas as ancoras da propria pagina, o botao de acao e o alternador de modo
    de cor - que existe porque o theme_boost do 5.2 nao tem nenhum.

    Os links saem do export "sections", a mesma lista de onde saem os id= das
    secoes no template da landing.

    NAO escreva chave dupla de mustache dentro deste comentario: ele termina no
    primeiro fecha-chaves, e o resto do texto vai parar na tela.

    Context variables required for this template:
    * sections - array de { id, label }
    * applyurl - URL do formulario de candidatura
    * brand - { name, homeurl, logolight, logodark, haslogo }
    * loginurl - URL da tela de login; o botao some para quem ja entrou
    * isloggedin - boolean
    * languages - array de { code, hreflang, label, short, url, iscurrent }
    * haslanguages - boolean; falso quando o site tem um idioma so ou o menu
                     de idiomas esta desligado

    Example context (json):
    {
        "applyurl": "/local/partners/apply.php",
        "loginurl": "/login/index.php",
        "isloggedin": false,
        "brand": {"name": "LeoDG", "homeurl": "/local/partners/index.php",
                  "logolight": "/logo.svg", "logodark": "/logo-dark.svg", "haslogo": true},
        "haslanguages": true,
        "languages": [
            {"code": "en", "hreflang": "en", "label": "English", "short": "EN",
             "url": "/local/partners/index.php?lang=en", "iscurrent": true},
            {"code": "pt_br", "hreflang": "pt-br", "label": "Portugues", "short": "PT",
             "url": "/local/partners/index.php?lang=pt_br", "iscurrent": false}
        ],
        "sections": [
            {"id": "ldgp-features", "label": "Features"},
            {"id": "ldgp-pricing", "label": "Plans"}
        ]
    }
}}
{{! O layout embedded nao traz o atalho do tema, e sem ele quem navega
    por teclado atravessa a barra inteira a cada pagina. }}
<a class="ldgp-skip" href="#ldgp-main">{{#str}}skiptomain, local_partners{{/str}}</a>
<div class="ldgp-bar">
    <div class="ldgp-bar-inner">
        {{#brand}}
            <a class="ldgp-brand" href="{{homeurl}}">
                {{#haslogo}}
                    <img src="{{logolight}}" alt="{{name}}" class="ldgp-brand-logo ldgp-brand-logo--light">
                    <img src="{{logodark}}" alt="{{name}}" class="ldgp-brand-logo ldgp-brand-logo--dark">
                {{/haslogo}}
                {{^haslogo}}
                    {{! Sem imagem, a marca continua existindo como palavra. }}
                    <span class="ldgp-brand-word">{{name}}</span>
                {{/haslogo}}
            </a>
        {{/brand}}

        <nav class="ldgp-bar-nav" aria-label="{{#str}}sectionnavlabel, local_partners{{/str}}">
            <ul class="ldgp-bar-list">
                {{#sections}}
                    <li><a class="ldgp-bar-link" href="#{{id}}">{{label}}</a></li>
                {{/sections}}
            </ul>
        </nav>

        <div class="ldgp-bar-actions">
            {{#haslanguages}}
                {{! Links de verdade, e nao um select com JavaScript: o buscador
                    segue link, e cada um casa com o hreflang do cabecalho. A
                    lista sai do que o Moodle tem instalado E habilitado. }}
                <div class="ldgp-langs dropdown">
                    <button type="button" class="ldgp-langbtn" data-bs-toggle="dropdown"
                            aria-expanded="false" aria-label="{{#str}}languageselector, local_partners{{/str}}">
                        {{> local_partners/icons/globe }}
                        <span>{{currentlanguage}}</span>
                        <span class="ldgp-caret" aria-hidden="true">{{> local_partners/icons/chevrondown }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end ldgp-langmenu">
                        {{#languages}}
                            <li>
                                <a class="dropdown-item ldgp-langitem{{#iscurrent}} ldgp-langitem--current{{/iscurrent}}"
                                   href="{{url}}" hreflang="{{hreflang}}" lang="{{hreflang}}"
                                   {{#iscurrent}}aria-current="true"{{/iscurrent}}>
                                    <span aria-hidden="true">{{short}}</span>
                                    <span class="visually-hidden">{{label}}</span>
                                </a>
                            </li>
                        {{/languages}}
                    </ul>
                </div>
            {{/haslanguages}}

            <button type="button" class="ldgp-modetoggle" data-ldgp="colormode"
                    aria-pressed="false" title="{{#str}}colormodetoggle, local_partners{{/str}}">
                <span class="visually-hidden">{{#str}}colormodetoggle, local_partners{{/str}}</span>
                {{> local_partners/icons/sun }}
                {{> local_partners/icons/moon }}
            </button>

            {{^isloggedin}}
                {{! Entrar e Aplicar sao o MESMO componente de botao, um
                    fantasma e o outro primario. O "Log in" da navbar e do tema:
                    mexer nele mudaria o link de login em toda pagina do site,
                    que e outra decisao. Aqui a landing responde por si. }}
                <a href="{{loginurl}}" class="ldgp-btn ldgp-btn--ghost">
                    {{#str}}login{{/str}}
                </a>
            {{/isloggedin}}

            <a href="{{applyurl}}" class="ldgp-btn ldgp-btn--primary">
                {{#str}}sectionapply, local_partners{{/str}}
            </a>
        </div>
    </div>
</div>
